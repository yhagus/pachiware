# Database Configuration (PostgreSQL 18)
POSTGRES_USER=pachiware
POSTGRES_PASSWORD=pachiware_secret
POSTGRES_DB=pachiware_agent
POSTGRES_PORT=5432
DATABASE_URL=postgresql://pachiware:pachiware_secret@localhost:5432/pachiware_agent

# Redis Configuration (Port 6380 to avoid collisions)
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# Agent API Service
AGENT_PORT=3001
AGENT_HOST=0.0.0.0
AGENT_SECRET_KEY=pachiware-super-secret-key-change-me

# Web Management GUI
NEXT_PUBLIC_API_URL=http://localhost:3001
VITE_API_URL=http://localhost:3001
PORT=3000

# Discord Bot Gateway Configuration
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# LLM Providers Configuration
# Active provider: "openai" | "anthropic" | "custom"
DEFAULT_LLM_PROVIDER=openai
DEFAULT_MODEL=gpt-4o

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
ANTHROPIC_API_KEY=

# Custom / 9router (OpenAI-compatible)
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_BASE_URL=https://api.9router.com/v1
CUSTOM_LLM_MODEL=gpt-4o
