# =============================================================================
# Database Configuration
# =============================================================================
# Pachiware ships with SQLite as the zero-config default — no Docker, no
# PostgreSQL instance required to get started. Just run `pachiware start` and
# a local SQLite file will be created at ./data/pachiware.db.
#
# Accepted DATABASE_URL formats:
#   sqlite:./data/pachiware.db                        (default — relative to repo root)
#   sqlite:/absolute/path/to/pachiware.db
#   sqlite::memory:                                   (ephemeral, test-only)
#   postgresql://user:pass@host:port/dbname           (opt-in Postgres)
#
# Leave DATABASE_URL unset to accept the SQLite default. Any other scheme stops
# the start. The engine is fixed after setup: see "Start Over on Another
# Database Engine" in README.md.
# =============================================================================
DATABASE_URL=sqlite:./data/pachiware.db

# Optional: PostgreSQL (only used when DATABASE_URL points at a postgres:// URL
# and/or when running with `pachiware start --docker`)
POSTGRES_USER=pachiware
POSTGRES_PASSWORD=pachiware_secret
POSTGRES_DB=pachiware_agent
POSTGRES_PORT=5432
# DATABASE_URL=postgresql://pachiware:pachiware_secret@localhost:5432/pachiware_agent

# Redis Configuration (Port 6380 to avoid collisions)
# Redis is optional — Pachiware falls back to a native in-memory cache if Redis
# is unreachable.
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# Agent API Service
AGENT_PORT=3001
AGENT_HOST=0.0.0.0
AGENT_SECRET_KEY=pachiware-super-secret-key-change-me

# Multi-tenant platform credentials.
# PLATFORM_ADMIN_KEY guards /api/admin/*; defaults to AGENT_SECRET_KEY.
# PLATFORM_ENCRYPTION_KEY: stable 32-byte key encoded as base64; required in production.
# Generate with: openssl rand -base64 32
# Development only: if unset, encryption derives a key from AGENT_SECRET_KEY.
# Changing either encryption key source makes previously encrypted secrets unreadable.
PLATFORM_ADMIN_KEY=
# PLATFORM_ENCRYPTION_KEY=

# Web Management GUI
# VITE_API_URL=http://localhost:3001
PORT=3000

# Tenant credentials belong in the database, encrypted with PLATFORM_ENCRYPTION_KEY.
# Provision tenants and API keys through /api/admin/*; use a tenant API key in
# the operator console. Runtime LLM/Discord code never reads credential env vars.
# Legacy variables are consulted ONLY by the first bootstrap migration:
# DISCORD_BOT_TOKEN=  DISCORD_CLIENT_ID=  DISCORD_GUILD_ID=
# OPENAI_API_KEY=  OPENAI_BASE_URL=  ANTHROPIC_API_KEY=
# CUSTOM_LLM_API_KEY=  CUSTOM_LLM_BASE_URL=  CUSTOM_LLM_MODEL=
# DEFAULT_LLM_PROVIDER=  DEFAULT_MODEL=

# Optional operator/CLI tenant credentials (not provider credentials)
# VITE_PACHIWARE_API_KEY=
# PACHIWARE_API_KEY=

# Public URL of the agent API; used to build the OAuth redirect URI
# (<PUBLIC_URL>/api/oauth/git/callback) for GitHub/GitLab "Continue with" login.
# CONSOLE_URL is where the admin console lives; the agent does not serve it, so this is where login returns to.
PUBLIC_URL=http://localhost:3001
# CONSOLE_URL=http://localhost:3000   (default; set to the console's public URL in production)

# Guardrails: observe (log only) | write (enforce confirmation, limits, duplicates) | enforce (default; adds scope, role, injection)
# GUARDRAIL_MODE=enforce

# Workspace: where the agent keeps tasks, notes and memory as Markdown files (one folder per tenant).
# Only "local" exists today; "s3" is planned. Back this directory up, or mount it as a volume in Docker.
WORKSPACE_DRIVER=local
WORKSPACE_DIR=./data/workspace
