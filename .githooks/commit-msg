#!/bin/sh
# Refuse a message that still has git's Conflicts block. Comment lines survive only when no editor ran
# (git sets GIT_EDITOR=:) or commit.cleanup keeps them; a --cleanup flag isn't visible here.
case "$(git config --get commit.cleanup)" in
  strip) exit 0 ;;
  whitespace | verbatim) ;;
  *) [ "$GIT_EDITOR" = ":" ] || exit 0 ;;
esac
if awk '
  mark != "" && index($0, mark) == 1 { found = 1; exit }
  { mark = "" }
  /^[^A-Za-z0-9 \t]+ Conflicts:$/ { mark = substr($0, 1, index($0, " ") - 1) "\t" }
  END { exit !found }
' "$1"; then
  cat >&2 <<'EOF'
commit-msg: the message still has git's "# Conflicts:" block from the merge.
Without an editor, git keeps those comment lines in the commit. Run
  git commit
without --no-edit and save the message: the editor drops the comment lines.
EOF
  exit 1
fi
