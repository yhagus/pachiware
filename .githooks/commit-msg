#!/bin/sh
# Refuse a message that still has git's Conflicts block from a conflicted merge.
# The hook sees the message before git cleans it up, so only look when the comment
# lines will survive. Git sets GIT_EDITOR=: when no editor ran (--no-edit, -m); by
# default it strips comments only after an editor. A --cleanup flag isn't visible here.
case "$(git config --get commit.cleanup)" in
  strip) exit 0 ;;
  whitespace | verbatim) ;;
  *) [ "$GIT_EDITOR" = ":" ] || exit 0 ;;
esac
if awk '
  mark != "" && index($0, mark) == 1 { found = 1; exit }
  { mark = "" }
  /^[^[:alnum:][:space:]]+ Conflicts:$/ { mark = substr($0, 1, index($0, " ") - 1) "\t" }
  END { exit !found }
' "$1"; then
  cat >&2 <<'EOF'
commit-msg: the message still has git's "# Conflicts:" block from the merge.
Without an editor, git keeps those comment lines in the commit. Run
  git commit
without --no-edit and save the message: the editor drops the comment lines.
EOF
  exit 1
fi
