{
  "name": "pachiware-agent-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:generate": "bun --filter @pachiware/db db:generate",
    "db:migrate": "bun --filter @pachiware/db db:migrate",
    "db:seed": "bun --filter @pachiware/db db:seed",
    "db:studio": "bun --filter @pachiware/db db:studio",
    "dev": "bun run dev:agent & bun run dev:web & wait",
    "dev:agent": "bun --filter @pachiware/agent dev",
    "dev:web": "bun --filter @pachiware/web dev",
    "build": "bun --filter @pachiware/* build",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "eval": "bun test ./apps/agent/eval/drafts.eval.ts",
    "eval:assistant": "bun test ./apps/agent/eval/assistant.eval.ts"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "bun-types": "1.4.0",
    "shadcn": "^4.21.2",
    "typescript": "^5.7.3"
  }
}
